---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import geistFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import monoFont from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import { Mail } from '@lucide/astro';
import { ClientRouter } from 'astro:transitions';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	ogRoute?: string;
}

const { title, description, noindex = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(pathname, site.url).href;
const ogRoute = Astro.props.ogRoute ?? (pathname === '/' ? 'index' : pathname.slice(1));
const image = new URL(`/og/${ogRoute}.png`, site.url).href;
const imageAlt = `${title} — ${description}`;

const person = { '@type': 'Person', name: site.name, url: site.url, sameAs: ['https://github.com/aelpxy', 'https://x.com/aelpxy'] };
const jsonLd =
	pathname === '/'
		? { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, author: person }
		: null;

// lucide dropped brand icons, so these are simple-icons paths
const brands = [
	{
		href: 'https://github.com/aelpxy',
		label: 'GitHub',
		path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12'
	},
	{
		href: 'https://twitter.com/aelpxy',
		label: 'X',
		path: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z'
	}
];

const pages = [
	{ href: '/projects', label: 'projects' },
	{ href: '/photos', label: 'photos' }
];

const isActive = (href: string) =>
	Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);

const linkClass = 'transition-colors hover:text-neutral-900 dark:hover:text-neutral-100';
---

<!doctype html>
<html lang="en" class="scheme-light-dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.png" sizes="96x96" type="image/png" />
		<link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.name} />
		<meta name="theme-color" content={site.themeColor} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
		{!noindex && <link rel="canonical" href={canonical} />}
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={image} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={site.twitter} />
		<meta name="twitter:creator" content={site.twitter} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content={imageAlt} />

		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

		<ClientRouter />
	</head>
	<body class="bg-neutral-50 text-[15.5px] leading-[1.7] text-neutral-500 antialiased dark:bg-neutral-950 dark:text-neutral-400">
		<main class="mx-auto flex min-h-dvh max-w-4xl flex-col border-r border-neutral-200 dark:border-neutral-800">
			<div class="flex flex-1 flex-col sm:flex-row">
				<div class="flex-1 px-6 pt-16 pb-24 sm:px-8" transition:name="content">
					<slot />
				</div>
				<aside class="sticky top-0 z-10 order-first border-b border-neutral-200 bg-neutral-50/85 backdrop-blur-md sm:static sm:order-last sm:w-40 sm:border-b-0 sm:bg-transparent sm:backdrop-blur-none dark:border-neutral-800 dark:bg-neutral-950/85 sm:dark:bg-transparent">
					<nav class="flex flex-col px-6 text-[13.5px] sm:sticky sm:top-0 sm:pt-[4.6rem] sm:pb-5">
						<a href="/" class="self-start pt-3 font-medium text-neutral-900 sm:mb-3 sm:pt-0 dark:text-neutral-100">aelpxy</a>
						<div class="flex justify-between sm:flex-col sm:justify-start sm:gap-1">
							{
								pages.map(({ href, label }) => (
									<a
										href={href}
										aria-current={isActive(href) ? 'page' : undefined}
										class:list={[
											linkClass,
											'py-2.5 whitespace-nowrap sm:py-0',
											isActive(href) && 'text-neutral-900 dark:text-neutral-100'
										]}
									>
										{label}
									</a>
								))
							}
						</div>
					</nav>
				</aside>
			</div>
			<footer class="flex justify-between gap-4 border-t border-neutral-200 px-6 py-6 text-[13px] sm:px-8 dark:border-neutral-800">
				<span>© {new Date().getFullYear()} aelpxy</span>
				<nav class="flex items-center gap-4">
					<a href="mailto:hey@aelpxy.dev" aria-label="Email" class={linkClass}>
						<Mail class="size-4" />
					</a>
					{
						brands.map(({ href, label, path }) => (
							<a href={href} aria-label={label} rel="noreferrer noopener" target="_blank" class={linkClass}>
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-3.5">
									<path d={path} />
								</svg>
							</a>
						))
					}
				</nav>
			</footer>
		</main>
	</body>
</html>
