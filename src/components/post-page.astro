---
import { ArrowLeft } from '@lucide/astro';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/base-layout.astro';
import { formatDate } from '../lib/date';
import { getReadingTime } from '../lib/reading-time';
import { ui } from '../lib/styles';
import PageHeader from './page-header.astro';

interface Props {
	post: CollectionEntry<'posts'>;
	backHref: string;
	backLabel: string;
}

const { post, backHref, backLabel } = Astro.props;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body ?? '');
---

<BaseLayout title={`${post.data.title} — aelpxy`} description={post.data.summary} article={{ publishedAt: post.data.publishedAt }}>
	<a
		href={backHref}
		class="inline-flex items-center gap-1.5 text-[13px] transition-colors hover:text-neutral-900 dark:hover:text-neutral-100"
	>
		<ArrowLeft class="size-3.5" />
		{backLabel}
	</a>

	<article class="mt-10">
		<PageHeader title={post.data.title}>
			<p class:list={[ui.meta, 'mt-4 flex gap-2.5']}>
				<time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
				<span aria-hidden="true" class="text-neutral-300 dark:text-neutral-700">·</span>
				<span>{readingTime.text}</span>
			</p>
		</PageHeader>

		<div class="prose prose-neutral mt-10 max-w-none dark:prose-invert">
			<Content />
		</div>
	</article>
</BaseLayout>
