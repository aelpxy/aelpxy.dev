---
import { getCollection } from 'astro:content';
import PostIndex from '../../components/post-index.astro';
import { pageMeta } from '../../lib/site';

const posts = await getCollection('posts', ({ data }) => !data.raw);
---

<PostIndex title={pageMeta.thoughts.title} subtitle={pageMeta.thoughts.description} basePath="/thoughts" posts={posts} />
