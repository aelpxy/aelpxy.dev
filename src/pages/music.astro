---
import PageHeader from '../components/page-header.astro';
import SectionHeading from '../components/section-heading.astro';
import BaseLayout from '../layouts/base-layout.astro';
import { pageMeta } from '../lib/site';
import { getListening } from '../lib/spotify';
import { ui } from '../lib/styles';

const { topTracks, topArtists } = await getListening();

const imageClass = 'size-5 shrink-0 bg-neutral-200 object-cover dark:bg-neutral-800';
---

<BaseLayout title="music — aelpxy" description={pageMeta.music.description} noindex>
	<PageHeader title={pageMeta.music.title} subtitle={pageMeta.music.description} />

	<section class="mt-12">
		<SectionHeading title="On repeat" note="last 4 weeks" />
		<ol class:list={['mt-4', ui.dividedList]}>
			{
				topTracks.map(({ name, artist, album, image, url }, i) => (
					<li>
						<a
							href={url}
							rel="noreferrer noopener"
							target="_blank"
							class="group grid grid-cols-[2rem_1.25rem_minmax(0,1fr)_minmax(0,40%)] items-center gap-3 py-3"
						>
							<span class={ui.meta}>{String(i + 1).padStart(2, '0')}</span>
							<img src={image} alt={album} width="20" height="20" loading="lazy" class:list={[imageClass, 'rounded-sm']} />
							<span class:list={[ui.rowLink, 'truncate']}>{name}</span>
							<span class="truncate text-right text-[14px]">{artist}</span>
						</a>
					</li>
				))
			}
		</ol>
	</section>

	<section class="mt-12">
		<SectionHeading title="Top artists" note="last 4 weeks" />
		<ul class="mt-4 flex flex-wrap gap-x-5 gap-y-3">
			{
				topArtists.map(({ name, image, url }) => (
					<li>
						<a href={url} rel="noreferrer noopener" target="_blank" class="group flex items-center gap-2">
							<img src={image} alt="" width="20" height="20" loading="lazy" class:list={[imageClass, 'rounded-full']} />
							<span class={ui.rowLink}>{name}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>
